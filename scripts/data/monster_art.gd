extends RefCounted

static var _cache: Dictionary = {}

static var _images := {
	"Luzik": "",
	"Bocznik": "",
	"Nucik": "",
	"Wahlik": "",
}

static func texture_for(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var encoded: String = str(_images.get(name, ""))
	if encoded.is_empty():
		return null
	var bytes := Marshalls.base64_to_raw(encoded)
	var image := Image.new()
	var err := image.load_jpg_from_buffer(bytes)
	if err != OK:
		return null
	var texture := ImageTexture.create_from_image(image)
	_cache[name] = texture
	return texture

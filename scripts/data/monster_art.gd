extends RefCounted

static var _cache: Dictionary = {}

static var _images: Dictionary = {
	"Luzik": "",
	"Bocznik": "",
	"Nucik": "",
	"Wahlik": ""
}

static func texture_for(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name] as Texture2D
	var encoded: String = str(_images.get(name, ""))
	if encoded.is_empty():
		return null
	var bytes: PackedByteArray = Marshalls.base64_to_raw(encoded)
	if bytes.is_empty():
		return null
	var image: Image = Image.new()
	var err: Error = image.load_webp_from_buffer(bytes)
	if err != OK:
		return null
	var texture: ImageTexture = ImageTexture.create_from_image(image)
	_cache[name] = texture
	return texture
